# Pinned sources for conformance fixtures. Bump in a dedicated PR.
RISCV_TESTS_COMMIT=7b68f7b91f827f8d94cc1c57ff123752c5c8f704
# riscv-arch-test: newest 3.x tag (RISCOF-based line; 4.x dropped RISCOF).
RISCV_ARCH_TEST_TAG=3.10.0
# Sail RISC-V formal model release (asset: sail-riscv-Linux-x86_64.tar.gz).
SAIL_RISCV_RELEASE=0.15
# RISCOF framework version on PyPI.
RISCOF_VERSION=1.25.3
# Test groups run from riscv-arch-test (rv32i_m/<group>) with the number of tests RISCOF must
# select and pass for each. The script fails if any group differs, so a pin bump or ISA YAML
# change cannot silently shrink the suite. Re-count deliberately when bumping the pins.
ARCH_TEST_EXPECTED="I=39 M=8 C=29 Zifencei=1 privilege=15 pmp32=41"
ARCH_TEST_TOTAL=133
# riscv-tests ELFs of tests/fixtures/riscv-tests the conformance bench runs, and those the skip list
# (riscv-tests-skip.txt) leaves out. crates/emu-cli/tests/riscv_tests.rs fails on any other count, so
# a new exclusion or a lost ELF cannot pass unnoticed. Re-count deliberately with the change.
RISCV_TESTS_RAN=64
RISCV_TESTS_SKIPPED=3
# ESP-IDF release whose gen_esp32part.py produces the partition-table reference binaries.
ESP_IDF_VERSION=v5.5.2
# Espressif's QEMU in the image espressif/idf:$ESP_IDF_VERSION, the oracle of the lockstep
# (inkemu-lockstep's --qemu; a test holds its default to this).
QEMU_ESP_BUILD=esp_develop_9.2.2_20250817
