// Sail RISC-V configuration (applied over the --rv32 defaults) that makes the reference model the
// same machine as inkemu: RV32IMC + Zicsr + Zifencei, M-mode only, fixed misa, and misaligned
// loads/stores raising an address-misaligned exception (the ISA YAML declares no hardware support).
{
  "base": {
    "hpmevent_width_bits": 32,
    "mstatus": { "fs_legal_states": "ExtContext_Off", "vs_legal_states": "ExtContext_Off" }
  },
  "memory": {
    "physaddr_bits": 32,
    "misaligned": {
      "exceptions": { "load_store": { "Some": "AlignmentException" } }
    }
  },
  "extensions": {
    "A": {
      "supported": false,
      "mutable_misa": false
    },
